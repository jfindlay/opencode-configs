{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5-5",
  "instructions": ["AGENTS.md"],
  "mcp": {},
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "mypy": {
      "command": ["pylsp"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "pylsp": {
          "plugins": {
            "pylsp_mypy": {
              "enabled": true,
              "live_mode": false,
              "strict": true
            },
            "pyflakes":    { "enabled": false },
            "pycodestyle": { "enabled": false },
            "autopep8":    { "enabled": false },
            "yapf":        { "enabled": false },
            "mccabe":      { "enabled": false }
          }
        }
      }
    },
    "yaml-ls": {
      "disabled": true
    }
  },
  "watcher": {
    "ignore": [
      // from .gitignore
      "__pycache__/**",
      "*.egg-info/**",
      "node_modules/**",
      "build/**",
      "dist/**",
      "artifacts/**",
      // tracked by git but high-churn / irrelevant to OpenCode
      ".venv/**",
      "uv.lock",
      // generated output
      "deploy/**",
      "test_results.xml",
      ".mypy_cache/**"
    ]
  },
  // Global: shell allowed with a few checkpoints (push, commit, destructive git); edits ask.
  // Applies to every agent as the base; agent rules append after it.
  // Ordered rules; the last matching rule wins. `edit` covers edit/write/patch.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    // The engine's defaults ask before reading environment files, but the blanket allow above
    // sits after them and wins (last match). Restore the defaults; `.env.example` stays readable.
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    // Shell is allowed by default; the rules below are consent checkpoints, not containment
    // (AGENTS-HINTS.md, "Shell permission rules are tripwires").
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    // The user-level config dir is allowed so on-demand AGENTS-*.md and skill references load
    // without an external_directory prompt per file.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    // Architect: edits ask, except the rolling-context docs (the allows follow the ask so they win).
    // The write triggers in AGENTS-REASONING.md bound what it writes there.
    "architect": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "**/docs/PLAN.md", "effect": "allow" },
        { "action": "edit", "resource": "**/docs/NOTES.md", "effect": "allow" },
        { "action": "edit", "resource": "**/docs/ROADMAP.md", "effect": "allow" }
      ]
    },
    // /plan/run agents write the default PLAN. In-project paths reach the engine project-relative,
    // so the rule names `docs/PLAN.md`; an absolute rule or `**/docs/PLAN.md` is not a substitute.
    // A non-default PLAN path needs explicit user authorization. File rules cannot enforce which
    // section either agent may write: the driver writes ledger and digest, the juncture fork
    // writes contracts for inflection design only (agents/plan-admin.md, agents/plan-juncture.md).
    "plan-admin": {
      "permissions": [
        { "action": "edit", "resource": "docs/PLAN.md", "effect": "allow" }
      ]
    },
    "plan-juncture": {
      "permissions": [
        { "action": "edit", "resource": "docs/PLAN.md", "effect": "allow" }
      ]
    },
    // Disable the built-in plan agent (replaced by @architect): the reserved name "plan" injects a
    // read-only system reminder that permission JSON and agent prose cannot override.
    "plan": {
      "disabled": true
    },
    // Build mode: inherits global permissions, but allows edits without prompting, except under
    // the config directory. A path rule matches only the spelling it names: the engine resolves no
    // symlink, so ~/.config/opencode and its target ~/Source/opencode-config need one rule each.
    // Files inside the project directory are matched as project-relative paths (`agents/x.md`),
    // so these absolute rules do not cover editing this repository while it is the project.
    // Approval is `ask`, and a saved `edit *` approval turns it back into allow; use `deny` for
    // a restriction that must survive one.
    "build": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "~/.config/opencode/**", "effect": "ask" },
        { "action": "edit", "resource": "~/Source/opencode-config/**", "effect": "ask" }
      ]
    }
  }
}
